    "onb.languages.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The big word on the card is in the language you are learning. Pick which translations to show."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупное слово на карточке — на изучаемом языке. Выберите, какие переводы показывать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Калимаи калон дар корт ба забони омӯхташаванда аст. Интихоб кунед, кадом тарҷумаҳо нишон дода шаванд."
          }
        }
      }
    },
    "label.learning": {
