    "onb_welcome_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LearnPaper turns your wallpaper into a flashcard: the word, how to say it, translations and an example. It changes by itself."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LearnPaper превращает обои в карточку: слово, произношение, переводы и пример. Обои меняются сами."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LearnPaper тасвири экрани шуморо ба корти калима табдил медиҳад: калима, талаффуз, тарҷумаҳо ва мисол. Он худ аз худ иваз мешавад."
          }
        }
      }
    },
