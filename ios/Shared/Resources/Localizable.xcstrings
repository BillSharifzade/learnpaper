    "ios_guide_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once set up, your wallpaper changes to the current card at the times you pick. It takes about five minutes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После настройки обои будут меняться на текущую карточку в выбранное время. Это займёт около пяти минут."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пас аз танзим тасвири экран дар вақтҳои интихобкардаи шумо ба корти ҷорӣ иваз мешавад. Ин тақрибан панҷ дақиқа вақт мегирад."
          }
        }
      }
    },
    "ios_guide_open" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper setup guide"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как настроить обои"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дастури танзими тасвири экран"
          }
        }
      }
    },
    "ios_guide_open_shortcuts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Shortcuts"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть «Команды»"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кушодани «Команды»"
          }
        }
      }
    },
    "ios_guide_step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Shortcuts app and tap + to create a new shortcut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте приложение «Команды» и нажмите +, чтобы создать новую команду."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барномаи «Команды» (Shortcuts)-ро кушоед ва барои сохтани фармони нав тугмаи «+»-ро пахш кунед."
          }
        }
      }
    },
    "ios_guide_step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the action “Get LearnPaper card” (search for LearnPaper)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте действие «Get LearnPaper card» (найдите LearnPaper в поиске)."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Амали «Get LearnPaper card»-ро илова кунед (дар ҷустуҷӯ LearnPaper-ро нависед)."
          }
        }
      }
    },
    "ios_guide_step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the action “Set Wallpaper” (on some iOS versions “Set Wallpaper Photo”), choose Lock Screen and Home Screen, and turn off “Show Preview”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте действие «Установить обои» (в некоторых версиях iOS — «Установить фото обоев»), выберите экран блокировки и главный экран и выключите «Показывать превью»."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Амали «Установить обои» (Set Wallpaper)-ро илова кунед (дар баъзе версияҳои iOS «Установить фото обоев»), экрани қулф ва экрани асосиро интихоб кунед ва «Показывать превью» (Show Preview)-ро хомӯш кунед."
          }
        }
      }
    },
    "ios_guide_step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name the shortcut “LearnPaper wallpaper” and run it once to check."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назовите команду «LearnPaper wallpaper» и запустите её один раз для проверки."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фармонро «LearnPaper wallpaper» ном гузоред ва барои санҷиш як бор иҷро кунед."
          }
        }
      }
    },
    "ios_guide_step5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to Automation, tap +, choose Time of Day, pick a time, select Run Immediately and choose the shortcut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перейдите в «Автоматизация», нажмите +, выберите «Время суток», задайте время, включите «Запускать сразу» и выберите команду."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ба «Автоматизация» (Automation) гузаред, «+»-ро пахш кунед, «Время суток» (Time of Day)-ро интихоб кунед, вақтро муайян кунед, «Запускать сразу» (Run Immediately)-ро фаъол кунед ва фармонро интихоб кунед."
          }
        }
      }
    },
    "ios_guide_step6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat step 5 for every hour you want a new card, e.g. 8:00, 9:00 … 22:00. iOS has no “every hour” trigger, so each time is its own automation."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторите шаг 5 для каждого часа, когда нужна новая карточка, например 8:00, 9:00 … 22:00. В iOS нет триггера «каждый час», поэтому каждое время — отдельная автоматизация."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қадами 5-ро барои ҳар соате, ки корти нав мехоҳед, такрор кунед, масалан 8:00, 9:00 … 22:00. Дар iOS триггери «ҳар соат» нест, бинобар ин ҳар вақт автоматизатсияи алоҳида аст."
          }
        }
      }
    },
    "ios_guide_tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wallpaper must be a normal photo wallpaper (not Photo Shuffle). Fewer steps: use “When charger connected” or “When Focus changes” triggers instead of times."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обои должны быть обычным фото (не «Перемешивание фото»). Меньше шагов: вместо времени используйте триггеры «При подключении зарядки» или «При смене фокусирования»."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тасвири экран бояд акси оддӣ бошад (на «Перемешивание фото» / Photo Shuffle). Барои қадамҳои камтар ба ҷои вақт триггерҳои «При подключении зарядки» ё «При смене фокусирования»-ро истифода баред."
          }
        }
      }
    },
    "ios_how_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS does not let apps change the wallpaper by themselves. You get two ways instead."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не позволяет приложениям самим менять обои. Вместо этого есть два способа."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ба барномаҳо иҷозат намедиҳад, ки тасвири экранро худашон иваз кунанд. Ба ҷои ин ду роҳ ҳаст."
          }
        }
      }
    },
    "ios_how_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How it works on iPhone"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как это работает на iPhone"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дар iPhone чӣ тавр кор мекунад"
          }
        }
      }
    },
