            "state": "translated",
            "value": "Ҳар соат як калимаи нав"
          }
        }
      }
    },
    "onb.welcome.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnPaper turns your wallpaper into a flashcard: a word, how to say it, its translations and an example. It changes on its own."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnPaper превращает обои в карточку: слово, произношение, переводы и пример. Обои меняются сами."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnPaper обои телефонро ба корти калима табдил медиҳад: калима, талаффуз, тарҷумаҳо ва мисол. Обои худ аз худ иваз мешавад."
          }
        }
      }
    },
    "onb.next": {
      "localizations": {
