    "onb.ios.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works on iPhone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как это работает на iPhone"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар iPhone чӣ тавр кор мекунад"
          }
        }
      }
    },
    "onb.ios.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS does not let apps change the wallpaper by themselves. You get two things instead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не позволяет приложениям менять обои самостоятельно. Вместо этого есть два способа."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ба барномаҳо иҷозат намедиҳад, ки обоиро худашон иваз кунанд. Ба ҷои он ду роҳ ҳаст."
          }
        }
      }
    },
    "ios.widget.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget — works by itself"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджет — работает сам"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджет — худаш кор мекунад"
          }
        }
      }
    },
    "ios.widget.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the LearnPaper widget to your Home Screen or Lock Screen. It shows the card and changes on schedule with no setup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте виджет LearnPaper на главный экран или экран блокировки. Он показывает карточку и меняется по расписанию без настройки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджети LearnPaper-ро ба экрани асосӣ ё экрани қулф илова кунед. Он кортро нишон медиҳад ва аз рӯи ҷадвал бе танзим иваз мешавад."
          }
        }
      }
    },
    "ios.shortcuts.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real wallpaper via Shortcuts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настоящие обои через Быстрые команды"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обои воқеӣ тавассути Shortcuts"
          }
        }
      }
    },
    "ios.shortcuts.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
