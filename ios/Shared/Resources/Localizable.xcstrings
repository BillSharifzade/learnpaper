    "guide.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once set up, your wallpaper changes to the current card at the times you pick. It takes about five minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После настройки обои будут меняться на текущую карточку в выбранное время. Это занимает около пяти минут."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пас аз танзим, обои дар вақтҳои интихобкардаатон ба корти ҷорӣ иваз мешавад. Тақрибан панҷ дақиқа мегирад."
          }
        }
      }
    },
    "guide.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Shortcuts app and tap + to create a new shortcut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Быстрые команды» и нажмите +, чтобы создать новую команду."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барномаи Shortcuts-ро кушоед ва барои сохтани фармони нав + -ро пахш кунед."
          }
        }
      }
    },
    "guide.step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the action “Get LearnPaper card” (search for LearnPaper)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте действие «Get LearnPaper card» (найдите LearnPaper в поиске)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амали «Get LearnPaper card»-ро илова кунед (LearnPaper-ро ҷустуҷӯ кунед)."
          }
        }
      }
    },
    "guide.step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the action “Set Wallpaper” (on some iOS versions “Set Wallpaper Photo”), choose Lock Screen and Home Screen, and turn off “Show Preview”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте действие «Установить обои» (в некоторых версиях iOS — «Установить фото обоев»), выберите экран блокировки и главный экран и выключите «Показывать превью»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амали «Set Wallpaper»-ро илова кунед (дар баъзе версияҳои iOS «Set Wallpaper Photo»), экрани қулф ва экрани асосиро интихоб кунед ва «Show Preview»-ро хомӯш кунед."
          }
        }
      }
    },
    "guide.step4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the shortcut “LearnPaper wallpaper” and run it once to check."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назовите команду «LearnPaper wallpaper» и запустите один раз для проверки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фармонро «LearnPaper wallpaper» номгузорӣ кунед ва барои санҷиш як бор иҷро кунед."
          }
        }
      }
    },
    "guide.step5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Automation, tap +, choose Time of Day, pick a time, select Run Immediately and choose the shortcut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в «Автоматизация», нажмите +, выберите «Время суток», задайте время, включите «Запускать сразу» и выберите команду."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба «Automation» гузаред, + -ро пахш кунед, «Time of Day»-ро интихоб кунед, вақтро муайян кунед, «Run Immediately»-ро интихоб кунед ва фармонро интихоб кунед."
          }
        }
      }
    },
    "guide.step6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat step 5 for every hour you want a new card, e.g. 8:00, 9:00 … 22:00. iOS has no “every hour” trigger, so each time is its own automation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите шаг 5 для каждого часа, когда нужна новая карточка, например 8:00, 9:00 … 22:00. В iOS нет триггера «каждый час», поэтому каждое время — отдельная автоматизация."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қадами 5-ро барои ҳар соате, ки корти нав мехоҳед, такрор кунед, масалан 8:00, 9:00 … 22:00. Дар iOS триггери «ҳар соат» нест, бинобар ин ҳар вақт автоматизатсияи алоҳида аст."
          }
        }
      }
    },
    "guide.tip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wallpaper must be a normal photo wallpaper (not Photo Shuffle). Fewer steps: use “When charger connected” or “When Focus changes” triggers instead of times."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обои должны быть обычным фото (не «Перемешивание фото»). Меньше шагов: вместо времени используйте триггеры «При подключении зарядки» или «При смене фокусирования»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обои бояд акси оддӣ бошад (на Photo Shuffle). Қадамҳои камтар: ба ҷои вақт триггерҳои «When charger connected» ё «When Focus changes»-ро истифода баред."
          }
        }
      }
    },
    "guide.openShortcuts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Shortcuts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть «Быстрые команды»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts-ро кушоед"
          }
        }
      }
    }
  }
}
