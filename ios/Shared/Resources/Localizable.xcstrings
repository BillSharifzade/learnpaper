        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что вы изучаете?"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шумо чӣ меомӯзед?"
          }
        }
      }
    },
    "onb_level_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one or more levels. You can change them at any time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно выбрать несколько уровней и изменить их в любой момент."
