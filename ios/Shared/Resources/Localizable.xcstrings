    "layout.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock screen widget and the Shortcuts card use the lower layout, so the clock stays clear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджет экрана блокировки и карточка для Быстрых команд используют нижнюю раскладку, чтобы часы оставались видны."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджети экрани қулф ва корти Shortcuts ҷойгиршавии поёнро истифода мебаранд, то соат намоён монад."
          }
        }
      }
