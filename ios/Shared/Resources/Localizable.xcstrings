    "onb.languages.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are you learning?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы изучаете?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шумо чӣ меомӯзед?"
          }
        }
      }
