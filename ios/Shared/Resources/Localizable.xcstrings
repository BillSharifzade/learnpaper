    "onb_languages_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The big word on the card is in this language. Translations appear underneath."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупное слово на карточке — на этом языке. Переводы показываются под ним."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калимаи калон дар корт ба ҳамин забон аст. Тарҷумаҳо дар зери он нишон дода мешаванд."
          }
        }
      }
    },
    "onb_languages_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What are you learning?"
