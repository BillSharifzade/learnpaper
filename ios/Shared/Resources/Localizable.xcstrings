          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акнун ин корти ҷорӣ аст"
          }
        }
      }
    },
    "ios_onb_finish" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start learning"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начать учиться"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омӯзишро оғоз кардан"
          }
        }
      }
    },
    "ios_onb_ready_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first word is ready. Widgets change by themselves; your wallpaper follows once Shortcuts is set up."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первое слово готово. Виджеты меняются сами, а обои — после настройки «Команд»."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калимаи аввалин тайёр аст. Виджетҳо худ аз худ иваз мешаванд, тасвири экран бошад — пас аз танзими «Команды» (Shortcuts)."
          }
        }
      }
    },
    "ios_schedule_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The widget follows this schedule by itself. For the wallpaper, create a Shortcuts automation for each time you want a change."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виджет сам следует этому расписанию. Для обоев создайте в «Командах» автоматизацию на каждое время смены."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виджет ин ҷадвалро худаш риоя мекунад. Барои тасвири экран дар «Команды» (Shortcuts) барои ҳар вақти иваз як автоматизатсия созед."
          }
        }
      }
    },
