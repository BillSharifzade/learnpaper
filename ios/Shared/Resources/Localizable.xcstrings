    "onb.welcome.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new word every hour"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новое слово каждый час"
          }
        },
        "tg": {
