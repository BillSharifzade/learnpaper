# content pipeline
content/cache/
content/build/
# generated app assets are rebuilt from content/ (kept out of git; run content/scripts/build.py)
android/app/src/main/assets/content/
# misc
.DS_Store
*.log
# iOS: the Xcode project is generated from ios/project.yml
ios/*.xcodeproj
ios/build/
ios/DerivedData/
*.xcuserstate
xcuserdata/

# Python venv for the content build (Pillow)
content/.venv/

# release signing (back these up; never commit)
android/keystore.properties
android/keystore/

# release artifacts (built with android/keystore.properties)
dist/
