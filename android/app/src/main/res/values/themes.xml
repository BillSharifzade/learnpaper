<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LearnPaper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Launch theme: the brand mark on paper until the first frame is ready (core-splashscreen). -->
    <style name="Theme.LearnPaper.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_iris</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LearnPaper</item>
    </style>
</resources>
