<?xml version="1.0" encoding="utf-8"?>
<!-- Progress and settings are backed up; downloaded word packs are re-downloadable and excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="packs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="packs/" />
    </device-transfer>
</data-extraction-rules>
